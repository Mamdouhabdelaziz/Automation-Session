<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="CrossBrowserSuite">

    <parameter name="websiteURL" value="https://the-internet.herokuapp.com/"></parameter>

    <test name="ChromeTest" enabled="false">
        <parameter name="browser" value="chrome"></parameter>
        <classes>
            <class name="cross_browser_test.CrossBrowserTCs"></class>
        </classes>
    </test>

    <test name="FireFoxTest" enabled="false">
        <parameter name="browser" value="firefox"></parameter>
        <classes>
            <class name="cross_browser_test.CrossBrowserTCs"></class>
        </classes>
    </test>

    <test name="EdgeTest" enabled="true">
        <parameter name="browser" value="edge"></parameter>
        <classes>
            <class name="cross_browser_test.CrossBrowserTCs"></class>
        </classes>
    </test>

</suite>